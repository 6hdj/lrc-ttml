<Page
    x:Class="Lyric2TTML.Shell.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="任务中心" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold" />
            <TextBlock Text="转换与下载的状态都来自后端真实任务（GET /api/tasks）；取消会真正打断任务。"
                       FontSize="{StaticResource CaptionSize}" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click" />
            <muxc:ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            <TextBlock x:Name="LbInfo" VerticalAlignment="Center"
                       FontSize="{StaticResource CaptionSize}" Opacity="0.8" Text="尚未刷新" />
        </StackPanel>

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <muxc:InfoBar x:Name="Bar" Grid.Row="0" IsOpen="False" IsClosable="True" />
            <ListView x:Name="List" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CardCorner}"
                                Padding="12" Margin="0,0,0,8" MinWidth="560">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                               VerticalAlignment="Center" Opacity="0.9" />
                                    <TextBlock Grid.Column="2" Text="{Binding Id}"
                                               VerticalAlignment="Center" Opacity="0.5" FontSize="12" />
                                    <Button Grid.Column="3" Content="取消" Tag="{Binding Id}"
                                            Click="BtnCancelOne_Click" />
                                </Grid>
                                <muxc:ProgressBar Value="{Binding Progress}" Maximum="100" />
                                <TextBlock Text="{Binding Stage}" FontSize="{StaticResource CaptionSize}"
                                           Opacity="0.85" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="查看日志" Tag="{Binding Id}" Click="BtnLogs_Click" />
                                    <Button Content="复制产物路径" Tag="{Binding Id}" Click="BtnPath_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
