<Page
    x:Class="Lyric2TTML.Shell.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PageMargin}" Spacing="18" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Spacing="8">
                <TextBlock Text="Lyric2TTML" FontSize="34" FontWeight="SemiBold" />
                <TextBlock Text="普通歌词（TXT/LRC）+ 音频 → Apple Music / AMLL 逐字 TTML"
                           FontSize="18" Opacity="0.8" TextWrapping="Wrap" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCorner}" Padding="{StaticResource CardPadding}">
                <StackPanel Spacing="10">
                    <TextBlock Text="三步开始" FontWeight="SemiBold" />
                    <TextBlock Text="1. 去「模型管理」确认语音识别模型已就绪（首次约 3 GB）"
                               TextWrapping="Wrap" />
                    <TextBlock Text="2. 去「歌词工作台」选音频 + 歌词，点开始处理"
                               TextWrapping="Wrap" />
                    <TextBlock Text="3. 处理完在「歌词编辑台」逐字校对并保存"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开歌词工作台" Style="{StaticResource AccentButtonStyle}"
                                Click="BtnWorkspace_Click" />
                        <Button Content="模型管理" Click="BtnModels_Click" />
                        <Button Content="运行库" Click="BtnRuntime_Click" />
                        <Button Content="环境检查" Click="BtnDiagnostics_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCorner}" Padding="{StaticResource CardPadding}">
                <StackPanel Spacing="6">
                    <TextBlock Text="说明（不隐藏限制）" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Opacity="0.8"
                               Text="· 界面状态与进度全部来自后端真实任务，不做假进度。" />
                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Opacity="0.8"
                               Text="· 阶段 4 迁移中：模型管理 / 运行库 / 设置 / 任务中心 / 编辑台已接真实数据。" />
                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource CaptionSize}" Opacity="0.8"
                               Text="· 未迁移的旧页面入口已从导航移除，功能都在上面四个入口里。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
