<Page
    x:Class="Lyric2TTML.Shell.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="模型管理" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold" />
            <TextBlock Text="状态全部来自后端真实检查（--model-cli json）；下载/校验/清理都真的执行，失败会显示原因。"
                       FontSize="{StaticResource CaptionSize}" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BtnRefresh" Content="刷新" Click="BtnRefresh_Click" />
            <muxc:ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            <TextBlock x:Name="LbStatus" VerticalAlignment="Center"
                       FontSize="{StaticResource CaptionSize}" Opacity="0.8" />
        </StackPanel>

        <muxc:InfoBar x:Name="Bar" Grid.Row="2" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="LbSummary" Grid.Row="0" TextWrapping="Wrap"
                       FontSize="{StaticResource CaptionSize}" Opacity="0.8" />
            <ListView x:Name="List" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"
                                           FontSize="{StaticResource CaptionSize}" Opacity="0.85" />
                                <TextBlock Text="{Binding Meta}" TextWrapping="Wrap"
                                           FontSize="{StaticResource CaptionSize}" Opacity="0.65" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="下载" Tag="{Binding Id}" Click="BtnDownload_Click"
                                            IsEnabled="{Binding CanDownload}" />
                                    <Button Content="校验" Tag="{Binding Id}" Click="BtnCheckOne_Click" />
                                    <Button Content="清理" Tag="{Binding Id}" Click="BtnCleanup_Click"
                                            IsEnabled="{Binding CanCleanup}" />
                                    <Button Content="打开位置" Tag="{Binding Location}" Click="BtnLocate_Click"
                                            IsEnabled="{Binding HasLocation}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
