<Page
    x:Class="Lyric2TTML.Shell.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls" Loaded="OnLoaded">
    <ScrollViewer>
        <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="设置" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold" />
                <TextBlock Text="这里只保存「外壳的默认值」；点开始处理时仍原样发给后端。"
                           FontSize="{StaticResource CaptionSize}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <muxc:InfoBar x:Name="Bar" Grid.Row="1" IsOpen="False" IsClosable="True" />

            <!-- 外观 -->
            <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCorner}" Padding="{StaticResource CardPadding}">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="14" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="主题" VerticalAlignment="Center" />
                        <ComboBox x:Name="CbTheme" Grid.Column="1" HorizontalAlignment="Stretch"
                                  SelectionChanged="CbTheme_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="0" />
                            <ComboBoxItem Content="浅色" Tag="1" />
                            <ComboBoxItem Content="深色" Tag="2" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 默认参数 -->
            <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCorner}" Padding="{StaticResource CardPadding}">
                <StackPanel Spacing="10">
                    <TextBlock Text="默认参数（下次打开工作台时预选）" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="14" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="识别模型" VerticalAlignment="Center" />
                        <ComboBox x:Name="CbModel" Grid.Column="1" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="large-v3（最准）" Tag="large-v3" />
                            <ComboBoxItem Content="medium" Tag="medium" />
                            <ComboBoxItem Content="small" Tag="small" />
                        </ComboBox>
                        <TextBlock Text="识别语言" Grid.Column="2" VerticalAlignment="Center" />
                        <ComboBox x:Name="CbLang" Grid.Column="3" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="自动检测" Tag="auto" />
                            <ComboBoxItem Content="中文" Tag="zh" />
                            <ComboBoxItem Content="英语" Tag="en" />
                            <ComboBoxItem Content="日语" Tag="ja" />
                        </ComboBox>
                        <TextBlock Text="演唱者分段" Grid.Row="1" VerticalAlignment="Center" />
                        <ComboBox x:Name="CbSinger" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="关闭（按歌词标记）" Tag="off" />
                            <ComboBoxItem Content="强制单声部" Tag="1" />
                            <ComboBoxItem Content="强制双声部" Tag="2" />
                            <ComboBoxItem Content="强制三声部" Tag="3" />
                        </ComboBox>
                        <TextBlock Text="歌词保存到" Grid.Row="2" VerticalAlignment="Center" />
                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="EdOutput" PlaceholderText="默认：程序目录\outputs（点「选择…」可改）" />
                            <Button Grid.Column="1" Content="选择…" Click="BtnBrowse_Click" />
                            <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                                       Text="⚠ 本机安全策略只允许本程序写自己的目录；选外部目录时转换会回退到默认目录（任务日志会写明原因）。"
                                       FontSize="{StaticResource CaptionSize}" Opacity="0.7" TextWrapping="Wrap"
                                       Margin="0,34,0,0" />
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="CkTails" Content="尾音延长（默认开）" />
                        <CheckBox x:Name="CkVerify" Content="AMLL 解析器复检（默认开）" />
                        <CheckBox x:Name="CkSameAgent" Content="同歌手拖音重叠（实验，默认关）" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Grid.Row="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardCorner}" Padding="{StaticResource CardPadding}">
                <StackPanel Spacing="8">
                    <TextBlock Text="关于" FontWeight="SemiBold" />
                    <TextBlock x:Name="LbVersion" FontSize="{StaticResource CaptionSize}" TextWrapping="Wrap" />
                    <TextBlock x:Name="LbBackend" FontSize="{StaticResource CaptionSize}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="打开后端日志" Click="BtnLog_Click" />
                        <Button Content="打开输出目录" Click="BtnOutput_Click" />
                        <Button Content="环境检查" Click="BtnDiagnostics_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 保存 -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnSave" Content="保存设置" Style="{StaticResource AccentButtonStyle}"
                        Click="BtnSave_Click" />
                <Button x:Name="BtnReset" Content="恢复默认" Click="BtnReset_Click" />
                <TextBlock x:Name="LbStatus" VerticalAlignment="Center"
                           FontSize="{StaticResource CaptionSize}" Opacity="0.7" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

