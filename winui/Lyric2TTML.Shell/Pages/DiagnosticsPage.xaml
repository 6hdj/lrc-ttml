<Page
    x:Class="Lyric2TTML.Shell.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="帮助 / 诊断" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold" />
            <TextBlock Text="真实调用 Python 后端（--doctor --json / HTTP /api/info），不做假数据。"
                       FontSize="{StaticResource CaptionSize}" Opacity="0.7" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BtnRefresh" Content="重新检查" Click="BtnRefresh_Click" />
            <Button x:Name="BtnCopy" Content="复制结果" Click="BtnCopy_Click" />
            <muxc:ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
            <TextBlock x:Name="LbStatus" VerticalAlignment="Center"
                       FontSize="{StaticResource CaptionSize}" Opacity="0.8" />
        </StackPanel>

        <!-- 后端进程：真启动 / 真停止 / 真日志，不是装饰按钮 -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="{StaticResource CardCorner}"
                Padding="{StaticResource CardPadding}">
            <StackPanel Spacing="8">
                <TextBlock Text="Python 后端（HTTP）" FontWeight="SemiBold" />
                <TextBlock x:Name="LbBackend" Text="未启动" TextWrapping="Wrap"
                           FontSize="{StaticResource CaptionSize}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnStart" Content="启动后端" Click="BtnStart_Click" />
                    <Button x:Name="BtnStop" Content="停止后端" Click="BtnStop_Click" />
                    <Button x:Name="BtnLog" Content="打开日志" Click="BtnLog_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <muxc:InfoBar x:Name="Bar" Grid.Row="0" IsOpen="False" IsClosable="True" />
            <ListView x:Name="List" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Key}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MinWidth="160" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Scope}" FontSize="12" Opacity="0.6" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
