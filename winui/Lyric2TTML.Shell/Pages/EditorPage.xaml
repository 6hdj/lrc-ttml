<Page
    x:Class="Lyric2TTML.Shell.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <!-- ⚠️ 整页套 ScrollViewer（2026-10-17 用户实测：属性面板展开后底部内容被切掉、
         而且**整页不能上下滚动**；全屏也一样）。根因是页面根是 Grid、行高 Auto 累积
         超过窗口高度时直接被裁掉。现在外层可滚，歌词区固定高度(440)自己内部滚。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="{StaticResource PageMargin}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="歌词编辑台" FontSize="{StaticResource TitleSize}" FontWeight="SemiBold" />
            <TextBlock Text="载入任务的编辑态 → 逐字渲染 → 播放驱动逐字高亮。高亮只改颜色，不改变布局（不抖动）。"
                       FontSize="{StaticResource CaptionSize}" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 选任务 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BtnLoad" Content="读取任务列表" Click="BtnLoad_Click" />
            <Button x:Name="BtnSaveTtml" Content="💾 保存 TTML" IsEnabled="False"
                    Click="BtnSaveTtml_Click" ToolTipService.ToolTip="把当前编辑（含元数据）写入 TTML 文件" />
            <ComboBox x:Name="CbTask" MinWidth="420" PlaceholderText="（点左边按钮读取）"
                      SelectionChanged="CbTask_SelectionChanged" />
        </StackPanel>

        <!-- 播放控制 -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="{StaticResource CardCorner}"
                Padding="{StaticResource CardPadding}">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BtnPlay" Content="▶ 播放" Click="BtnPlay_Click" />
                    <Button x:Name="BtnPause" Content="⏸ 暂停" Click="BtnPause_Click" />
                    <TextBox x:Name="EdJump" Width="90" PlaceholderText="秒" />
                    <Button x:Name="BtnJump" Content="跳转" Click="BtnJump_Click" />
                    <TextBlock x:Name="LbPos" VerticalAlignment="Center" FontFamily="Consolas"
                               FontSize="{StaticResource CaptionSize}" Text="0.000s" />
                    <!-- MediaPlayer 的宿主：非打包 WinUI 3 里裸 MediaPlayer 常常不出声，
                         官方示例都用 MediaPlayerElement 承载。这里 1px 高，不占版面。 -->
                    <MediaPlayerElement x:Name="AudioHost" Height="1"
                                        AreTransportControlsEnabled="False"
                                        HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="LbTruth" FontSize="12" Opacity="0.7" TextWrapping="Wrap" FontFamily="Consolas" Text="真相：未载入" />
                    <TextBlock x:Name="LbState" VerticalAlignment="Center"
                               FontSize="{StaticResource CaptionSize}" Opacity="0.75" Text="状态：未载入" />
                </StackPanel>

                <!-- 选中 → 编辑：**先选字、再编辑**（点字只跳转，不弹框打断试听） -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="LbSel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               FontSize="{StaticResource CaptionSize}" Text="当前选中：未选" MinWidth="360" />
                    <Button x:Name="BtnEditWord" Content="✏️ 改这个字的时间" Click="BtnEditWord_Click" />
                    <Button x:Name="BtnEditAgent" Content="🔁 改这一行声部" Click="BtnEditAgent_Click" />
                </StackPanel>

                <TextBlock x:Name="LbAudio" FontSize="12" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" Text="音频：未载入" />
                <muxc:InfoBar x:Name="Bar" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </Border>

        <!-- 歌词（每行一个 TextBlock，逐字 Run）-->
        <Border Grid.Row="3" Height="440"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="{StaticResource CardCorner}">
            <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LinesHost" Spacing="0" />
            </ScrollViewer>
        </Border>
    </Grid>
    </ScrollViewer>
</Page>
