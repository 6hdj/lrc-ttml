<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 全局设计令牌：颜色/圆角/间距/字号。页面只能引用，不得各写一套。 -->
    <Thickness x:Key="PageMargin">32,24,32,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <CornerRadius x:Key="CardCorner">8</CornerRadius>
    <CornerRadius x:Key="ControlCorner">4</CornerRadius>
    <x:Double x:Key="GapS">4</x:Double>
    <x:Double x:Key="GapM">8</x:Double>
    <x:Double x:Key="GapL">16</x:Double>
    <x:Double x:Key="BodySize">14</x:Double>
    <x:Double x:Key="CaptionSize">12</x:Double>
    <x:Double x:Key="TitleSize">28</x:Double>
</ResourceDictionary>
